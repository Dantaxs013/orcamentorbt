# ========================================================
# RBT ORÇAMENTOS - VARIÁVEIS DE AMBIENTE
# ========================================================

# Conexão com o banco de dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rbt_orcamentos?schema=public"

# URL base da aplicação para geração do Magic Link e redirects
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Segredo para assinatura de tokens de sessão
SESSION_SECRET="rbt-orcamentos-super-secret-key-change-in-production-2026"

# Configurações do servidor corporativo de e-mail (Nodemailer / SMTP)
SMTP_HOST="smtp.exemplo.com.br"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="orcamentos@rbt.com.br"
SMTP_PASS="sua_senha_smtp_aqui"
SMTP_FROM="RBT Orçamentos <orcamentos@rbt.com.br>"
